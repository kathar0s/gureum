        <window title="≪ do not localize ≫" releasedWhenClosed="NO" visibleAtLaunch="NO" id="F0z-JX-Cv5" userLabel="Preferences control bindings">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <rect key="contentRect" x="176" y="100" width="500" height="440"/>
